{
  "name": "brandbuild-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "e2e": "playwright test",
    "api:lint": "redocly lint ../../../docs/api/openapi.yaml --config ../../../docs/api/redocly.yaml",
